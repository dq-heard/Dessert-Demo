---
import { Icon } from "astro-icon/components";
import { site } from "../data/site";

const year = new Date().getFullYear();

const quickLinks = [
  { href: "/", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/#shop", label: "Shop" },
  { href: "/#connect", label: "Connect" },
  { href: "/#visit", label: "Visit Us" },
  { href: "/#policies", label: "Policies" },
];
---

<footer>
  <div class="bg-img text-white footer">
    <div class="container">
      <!-- gx-4 below md: a gx-5 row needs 1.5rem of container padding, and .container only has .75rem,
           so gx-5 on phones pushes the page wider than the viewport -->
      <div class="row gx-4 gx-md-5">
        <div class="col-lg-4 col-md-6">
          <!-- No h-100: the box keeps its own height instead of stretching to the neighboring columns -->
          <div
            class="d-flex flex-column align-items-center justify-content-center text-center bg-primary border-inner p-4"
          >
            <a
              href="/"
              class="navbar-brand d-inline-flex align-items-center justify-content-center font-primary text-darker brand-lg m-0"
            >
              <Icon name={site.brandIcon} class="me-2" aria-hidden="true" />
              {site.name}
            </a>
            <!-- text-darker: white on this pink is ~1.7:1 -->
            <p class="mt-3 mb-3 text-darker">{site.blurb}</p>
            <!-- Socials live here so they're still reachable when the columns below are hidden -->
            <div class="d-flex justify-content-center">
              {
                site.socials.map((s) => (
                  <a
                    class="btn btn-lg btn-dark btn-lg-square border-inner mx-1"
                    href={s.href}
                    aria-label={s.label}
                    target="_blank"
                    rel="noopener"
                  >
                    <Icon name={s.icon} aria-hidden="true" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- At md only, center the newsletter vertically beside the brand box instead of top-aligning it -->
        <div
          class="col-lg-8 col-md-6 d-md-flex align-items-md-center d-lg-block"
        >
          <div class="row gx-3 flex-grow-1">
            <!-- Get in Touch and Quick Links only show at lg and up. Below that the Visit Us
                 section and the nav already carry the same information. -->
            <div class="col-lg-4 d-none d-lg-block pt-5 mb-5">
              <h2 class="h4 text-primary text-uppercase mb-4">Get in Touch</h2>
              <!-- Same details as the Visit Us section, both read from site.ts -->
              <ul class="list-unstyled mb-0">
                <li class="d-flex mb-2">
                  <Icon
                    name="fa6-solid:location-dot"
                    size={25}
                    class="text-primary me-2 flex-shrink-0"
                    aria-hidden="true"
                  />
                  <address class="mb-0">
                    {
                      site.address.map((line, i) => (
                        <>
                          {line}
                          {i < site.address.length - 1 && <br />}
                        </>
                      ))
                    }
                  </address>
                </li>
                <li class="d-flex mb-2">
                  <Icon
                    name="fa6-solid:phone"
                    size={25}
                    class="text-primary me-2 flex-shrink-0"
                    aria-hidden="true"
                  />
                  <a class="link-light" href={`tel:${site.phoneHref}`}
                    >{site.phone}</a
                  >
                </li>
                <li class="d-flex mb-2">
                  <Icon
                    name="fa6-solid:envelope"
                    size={25}
                    class="text-primary me-2 flex-shrink-0"
                    aria-hidden="true"
                  />
                  <a class="link-light" href={`mailto:${site.email}`}
                    >{site.email}</a
                  >
                </li>
              </ul>
            </div>

            <div class="col-lg-4 d-none d-lg-block pt-5 mb-5">
              <h2 class="h4 text-primary text-uppercase mb-4">Quick Links</h2>
              <ul class="list-unstyled mb-0">
                {
                  quickLinks.map((l) => (
                    <li class="mb-2">
                      <a
                        class="link-light d-inline-flex align-items-center"
                        href={l.href}
                      >
                        <Icon
                          name="fa6-solid:arrow-right"
                          size={16}
                          class="text-primary me-2"
                          aria-hidden="true"
                        />
                        {l.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <!-- Stacked under the brand box below md, beside it at md, third column at lg -->
            <div
              class="col-12 col-lg-4 pt-5 pt-md-0 pt-lg-5 mb-5 mb-md-0 mb-lg-5"
            >
              <h2 class="h4 text-primary text-uppercase mb-4">Subscribe</h2>
              <p>First time subscribers get 10% off their first purchase.</p>
              <!-- TODO: wire up /api/newsletter, or remove the form for the demo -->
              <form action="/api/newsletter" method="post">
                <label for="newsletter-email" class="visually-hidden"
                  >Email address</label
                >
                <div class="input-group">
                  <input
                    id="newsletter-email"
                    name="email"
                    type="email"
                    class="form-control border-white p-3"
                    placeholder="Your email"
                    autocomplete="email"
                    required
                  />
                  <button type="submit" class="btn btn-primary">Sign Up</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-dark text-white py-4">
    <div class="container text-center">
      <p class="mb-0">
        &copy; {year}{" "}
        {site.legalName}. Demo project, no real products.
        {
          site.credit && (
            <>
              Built by{" "}
              <a class="link-light" href={site.credit.url}>
                {site.credit.name}
              </a>
              .
            </>
          )
        }
      </p>
    </div>
  </div>
</footer>

<button
  type="button"
  class="back-to-top btn btn-primary btn-lg-square border-inner"
  aria-label="Back to top"
  hidden
>
  <Icon name="fa6-solid:arrow-up" aria-hidden="true" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>(".back-to-top");

  if (button) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const update = () => {
      button.hidden = window.scrollY < 600;
    };

    window.addEventListener("scroll", update, { passive: true });
    update();

    button.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: reduce.matches ? "auto" : "smooth" })
    );
  }
</script>
