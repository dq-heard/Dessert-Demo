---
import { Icon } from "astro-icon/components";
import { site } from "@/data/site";

// Placeholder stats for the demo
const stats = [
  { icon: "fa6-solid:star", label: "Baking since", value: "2015" },
  { icon: "fa6-solid:cake-candles", label: "Batch Count", value: "400+" },
];
---

<div class="facts-bg">
  <div class="container py-5 px-5 px-xl-0">
    <div class="row gx-5 gy-4 justify-content-center align-items-xl-center">
      <div class="col-xl-6 py-xl-4 facts-col">
        <!-- Label/value pairs, so a description list rather than headings -->
        <dl class="row gx-3 gy-4 mb-0">
          {
            stats.map((s) => (
              <div class="col d-block d-sm-flex">
                <div class="bg-primary border-inner d-flex align-items-center justify-content-center mb-3 icon-box-sm">
                  <Icon
                    name={s.icon}
                    size={24}
                    class="text-darker"
                    aria-hidden="true"
                  />
                </div>
                <div class="pt-2 ps-sm-4 pt-sm-0">
                  <dt class="h6 text-secondary text-uppercase">{s.label}</dt>
                  <dd class="display-5 text-white mb-0">{s.value}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="col-xl-6 py-xl-4 facts-col">
        <h3 class="h4 text-secondary mb-3 mb-xl-4">
          We appreciate your interest in our desserts.
        </h3>
        <p class="text-white">
          Our vision is to be the neighborhood's favorite bakery, with a focus
          on real connections over a shared table. At the core of {site.name}{
            " "
          }
          are three values: quality, dedication and unwavering passion.
        </p>
      </div>
    </div>
  </div>
</div>
