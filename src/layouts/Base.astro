---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.tsx";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const siteName = site.name;
const { title, description = site.description, image } = Astro.props;

const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
// Needs `site` set in astro.config.mjs
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage = image && Astro.site ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="  https://fonts.googleapis.com/css2?family=Gluten:wght@400;700&family=Lemonada:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Copy the integrity attribute from getbootstrap.com's CDN snippet -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link visually-hidden-focusable" href="#main"
      >Skip to main content</a
    >
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CartDrawer client:only="react" />

    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>
</html>
